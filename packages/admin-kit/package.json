{
  "name": "admin-kit-yu",
  "version": "0.3.1",
  "description": "API-driven admin dashboard generator, OpenAPI introspector, and embedded studio engine",
  "type": "module",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "admin-kit-yu": "./dist/cli/index.js",
    "admin-kit": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./style.css": "./dist/style.css",
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run build:spa && pnpm run build:lib && pnpm run build:css",
    "build:spa": "vite build",
    "build:lib": "tsup",
    "build:css": "node -e \"const fs=require('fs'); fs.copyFileSync('src/react/styles/admin-studio.css', 'dist/style.css'); fs.copyFileSync('src/react/styles/admin-studio.css', 'dist/public/style.css');\"",
    "dev": "tsup --watch",
    "test": "tsx --test test/config.test.ts test/evaluator.test.ts test/client.test.ts test/rbac.test.ts test/cli.test.ts test/ai.test.ts test/express.test.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@apidevtools/swagger-parser": "^10.1.0",
    "@tanstack/react-table": "^8.16.0",
    "@tanstack/table-core": "^8.16.0",
    "ai": "^7.0.166",
    "commander": "^12.0.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^0.378.0",
    "react-hook-form": "^7.51.3",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.43",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/serve-static": "^1.15.7",
    "@vitejs/plugin-react": "^4.2.1",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vite": "^5.4.21"
  }
}
