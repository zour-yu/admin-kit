{
  "name": "@admin-kit-yu/express",
  "version": "0.2.0",
  "description": "Express middleware for AdminKit providing SPA static assets and configuration metadata endpoints",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --experimental-strip-types --test test/express.test.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@admin-kit-yu/core": "workspace:*",
    "@admin-kit-yu/react": "workspace:*",
    "yaml": "^2.4.5"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.43",
    "@types/serve-static": "^1.15.7",
    "@types/node": "^20.12.7",
    "express": "^4.19.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
