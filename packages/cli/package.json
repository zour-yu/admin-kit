{
  "name": "@admin-kit-yu/cli",
  "version": "0.2.1",
  "description": "CLI tool for AdminKit OpenAPI introspection and configuration management",
  "type": "module",
  "bin": {
    "admin-kit": "./bin/admin-kit.js",
    "admin-kit-yu": "./bin/admin-kit.js",
    "cli": "./bin/admin-kit.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --experimental-strip-types --test test/cli.test.ts test/ai.test.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@admin-kit-yu/core": "workspace:*",
    "@admin-kit-yu/express": "workspace:*",
    "@ai-sdk/google": "^4.0.114",
    "@apidevtools/swagger-parser": "^10.1.0",
    "ai": "^7.0.166",
    "commander": "^12.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
